   "source": [
    "import pandas as pd\n",
    "\n",
    "customer= pd.read_csv(\"customers_1.csv\")\n",
    "order= pd.read_csv(\"orders.csv\")\n",
    "\n",
    "pd= order.merge(customer, on=\"customer_id\", how=\"left\")\n",
    "\n",
    "r= pd.groupby(\"gender\", as_index=False)[\"total_amount\"].mean().rename(columns={\"total_amount\":\"avg_amount\"})\n",
    "\n",
    "r"
   ]
  }
