   "source": [
    "import pandas as pd\n",
    "\n",
    "df= pd.read_csv(\"transactions.csv\")\n",
    "\n",
    "df[\"sl\"]= df.groupby(\"user_id\").cumcount()+1\n",
    "\n",
    "r= df[df[\"sl\"] %3 ==0].reset_index(drop=True)[[\"user_id\",\"spend\",\"transaction_date\"]]\n",
    "\n",
    "r"
   ]
  }
