   "source": [
    "import pandas as pd\n",
    "df= pd.read_csv(\"events.csv\")\n",
    "r= df.groupby([\"app_id\",\"event_type\"]).size().unstack(fill_value=0).reset_index()\n",
    "r[\"total\"]= r[\"click\"] + r[\"impression\"]\n",
    "r[\"ctr\"]= r[\"click\"]/r[\"total\"]\n",
    "r[\"ctr\"]= r[\"ctr\"].map(\"{:.2%}\".format)\n",
    "r"
   ]
  },
